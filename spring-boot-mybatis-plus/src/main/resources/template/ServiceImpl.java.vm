                .eq(query.get${column.attrName}() != null, ${className}DO::get${column.attrName}, query.get${column.attrName}())#end#end#end
        ;
        Page<${className}DO> page = new Page<>(query.getPageNum(), query.getPageSize());
        IPage<${className}DO> iPage = page(page, queryWrapper);
        return PageResult.restPage(iPage, ${className}Convert.INSTANCE.convertList(iPage.getRecords()));
    }

