@Service
public class ${className}ServiceImpl extends SuperServiceImpl<${className}Mapper, ${className}DO> implements ${className}Service {

    @Override
    public void save(${className}SaveReq form) {
        save(${className}Convert.INSTANCE.convert(form));
    }

    @Override
    public void edit(Long id, ${className}SaveReq form) {
        ${className}DO ${classname}Do = ${className}Convert.INSTANCE.convert(form);
        ${classname}Do.setId(id);
        updateById(${classname}Do);
    }

    @Override
    public ${className}DetailResp get(Long id) {
